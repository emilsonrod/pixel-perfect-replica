# Copia este archivo a ".env" (o ".env.local") y completa los valores.
# Nunca subas el archivo con valores reales al repositorio.

# Supabase -> Project Settings -> API
# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública (publishable / anon). Es seguro que viaje al navegador porque
# la seguridad real la aplica Row Level Security en la base de datos.
# NUNCA uses aquí la clave service_role ni una clave sb_secret_...: la aplicación la rechaza.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Slug del negocio en la tabla public.businesses (opcional, por defecto "casa-luma").
VITE_BUSINESS_SLUG=casa-luma
